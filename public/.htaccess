# ==============================================================================
# HTACCESS UNTUK SERVING APLIKASI DI HOSTINGER (DIST / PUBLIC_HTML / SUBFOLDER)
# ==============================================================================
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Direct all api/ requests to the native Hostinger PHP API router (api/index.php)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # 2. Allow direct access to static files or existing folders (js, css, images, uploads)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Route all SPA client routes to relative index.html
  RewriteRule ^ index.html [L]
</IfModule>
